#include <windows.h>

IDI_ICON1 ICON "@ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @VERSION_COMMA@,0
 PRODUCTVERSION @VERSION_COMMA@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "STL2STEP contributors\0"
            VALUE "FileDescription", "STL2STEP FC\0"
            VALUE "FileVersion", "@VERSION@\0"
            VALUE "InternalName", "STL2STEP\0"
            VALUE "LegalCopyright", "MIT License\0"
            VALUE "OriginalFilename", "STL2STEP.exe\0"
            VALUE "ProductName", "STL2STEP FC\0"
            VALUE "ProductVersion", "@VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
